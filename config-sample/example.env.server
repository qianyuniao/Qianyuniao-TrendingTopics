# 复制为项目根目录的 .env.server 后按需填写：cp config-sample/example.env.server .env.server
# 以下变量全部可选：留空则对应能力自动关闭，不影响启动

# ---- 登录与多端同步（GitHub OAuth）----
# 启用登录时 JWT_SECRET 必填，否则无法签发会话
G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=

# ---- 数据库 ----
# 首次启动是否初始化数据表（默认 true）
INIT_TABLE=true
# 是否启用数据库缓存（默认 true）
ENABLE_CACHE=true

# ---- 数据源令牌 ----
# Product Hunt（不填则 Product Hunt 卡片返回空）
PRODUCTHUNT_API_TOKEN=

# ---- 热榜（Hotboard，已内置于 Node 服务端，无独立服务、无端口）----
# 抓取结果缓存秒数，默认 60
# HOTBOARD_CACHE_TTL=60
# 小红书热搜：默认走免配置的公共聚合接口，开箱即用。
# 下面三项为「官方接口」增强项，可选：浏览器登录后从开发者工具复制 Cookie
# （含 a1、web_session 等）填入，即可改取小红书官方热搜榜；
# 官方接口带风控，若返回 406 还需从 Network 复制 x-s / x-t 请求头填入。
# 注意：Cookie 与签名都会过期，过期后自动回退到公共聚合接口。
# XIAOHONGSHU_COOKIE=
# XIAOHONGSHU_XS=
# XIAOHONGSHU_XT=
# 微信视频号：官方未开放热榜接口（内容在微信客户端内，web 端无榜单 API），
# 默认返回空、看板只展示官网入口。若你有可用的视频号榜单接口或商业数据平台接口，
# 把完整接口地址填入下面这项即可接入（返回 { data: { list: [...] } } 或 { list: [...] }）。
# WEIXIN_CHANNELS_API_URL=
# 该接口若需要登录态，可一并配置 Cookie
# WEIXIN_CHANNELS_COOKIE=

# ---- 代理（按需）----
# 上游站点不可直连时设置，Node 会原生为 fetch 启用
# （dev 脚本已带 --use-env-proxy；生产可用 NODE_USE_ENV_PROXY=1，也可直接在 shell 导出）
# HTTPS_PROXY=
# HTTP_PROXY=
